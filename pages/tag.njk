---
layout: layouts/base.njk
pagination:
  data: collections.taggedWriting
  size: 1
  alias: tag
permalink: /tags/{{ tag }}/
eleventyComputed:
  title: "#{{ tag }}"
eleventyExcludeFromCollections: true
writingNav: true
---
<header class="archive-opening">
    <h1>#{{ tag }}</h1>
    {% include "mark.njk" %}
</header>
{% set entries = collections.taggedWriting[tag] %}
{% for item in entries %}
    {% set itemYear = item.date | year %}
    {% if loop.first or itemYear != (entries[loop.index0 - 1].date | year) %}
        {% if not loop.first %}</ol></section>{% endif %}
        <section class="archive-year" aria-label="{{ itemYear }} writing">
        <h2>{{ itemYear }}</h2><ol class="archive-index">
    {% endif %}
    <li><a href="{{ item.url }}"><span>{{ item.data.title }}</span>
            <time datetime="{{ item.date | dateISO }}">{{ item.date | dateShort }}</time>
        </a></li>
    {% if loop.last %}</ol></section>{% endif %}
{% endfor %}
<p class="archive-return"><a href="/writings/">← All writing</a></p>
