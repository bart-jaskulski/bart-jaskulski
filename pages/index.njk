---
permalink: /
layout: layouts/base.njk
description: I build software with PHP, TypeScript and occasionally Go. Tech Lead @ WP Desk
---
<section class="clearing" aria-label="Introduction">
    <p>I build software with PHP, TypeScript and occasionally Go. Tech Lead @ WP Desk</p>
    <div class="monostich">
        <h1 aria-label="Break things. Reassemble."><span aria-hidden="true">Break things.</span><span aria-hidden="true">Reassemble.</span></h1>
        {% include "monostich.svg" %}
        <p class="monostich-credit"></p>
    </div>
    <nav class="routes" aria-label="Explore the site"><a href="#work">Work ↓</a><a
            href="/writings/">Writing ↗</a><a href="/audiolog/">Audiolog ↗</a></nav>
    {% set markClass = "seal" %}
    {% include "mark.njk" %}
</section>
<script src="{{ '/assets/monostich.js' | hash }}" type="module"></script>
<section id="work" aria-label="Work">
    {% set featured = collections.work[0] %}
    {% set second = collections.work[1] %}
    <article class="featured-work">
        <div class="work-heading">
            {% include "marks/picknext.svg" %}
            <h2>{% if featured.data.title_lines %}{% for line in featured.data.title_lines %}<span>{{ line }}</span>{% endfor %}{% else %}{{ featured.data.title }}{% endif %}</h2>
        </div>
        <div class="work-story">
            <div>{{ featured.templateContent | safe }}</div>
            <a class="route" href="{{ featured.data.url }}">{{ featured.data.link_label }} ↗</a>
        </div>
    </article>
    <article class="second-work">
        <div class="work-heading">
            {% include "marks/tildom.svg" %}
            <h3>{{ second.data.title }}</h3>
        </div>
        <div>{{ second.templateContent | safe }}</div>
        <a href="{{ second.data.url }}">{{ second.data.link_label }} ↗</a>
    </article>
    <div class="tertiary-work" aria-label="More work at WP Desk">
        {% for item in collections.work.slice(2) %}
        <article>
            <h3>{{ item.data.title }}</h3>
            <div>{{ item.templateContent | safe }}</div>
            <a href="{{ item.data.url }}">{{ item.data.link_label }} ↗</a>
        </article>
        {% endfor %}
    </div>
</section>
<section id="writing" aria-labelledby="writing-title">
    <h2 id="writing-title"><a href="/writings/">Writing <span aria-hidden="true">↗</span></a></h2>
    <div class="pieces">
        {% for item in collections.writing.slice(0, 6) %}
        <article>
            <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
            <p>{{ item.data.description | safe }}</p>
            <time datetime="{{ item.date | dateISO }}">{{ item.date | dateLabel }}</time>
        </article>
        {% endfor %}
    </div>
</section>
